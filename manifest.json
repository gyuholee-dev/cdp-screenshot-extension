{
  "manifest_version": 3,
  "default_locale": "ko",
  "name": "__MSG_ext_name__",
  "version": "0.2.0",
  "description": "__MSG_ext_description__",
  "minimum_chrome_version": "141",
  "permissions": [
    "debugger",
    "downloads",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus"
  ],
  "background": {
    "service_worker": "extension/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_ext_actionTitle__",
    "default_icon": {
      "16": "extension/icons/icon-16.png",
      "32": "extension/icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "extension/panel.html"
  },
  "commands": {
    "viewport": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "__MSG_kind_viewport__"
    },
    "full": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "__MSG_kind_full__"
    },
    "element": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "__MSG_kind_element__"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmd_togglePanel__"
    }
  },
  "icons": {
    "16": "extension/icons/icon-16.png",
    "32": "extension/icons/icon-32.png",
    "48": "extension/icons/icon-48.png",
    "128": "extension/icons/icon-128.png"
  }
}
