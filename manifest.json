{
  "manifest_version": 3,
  "name": "CDP Screenshot",
  "version": "0.2.0",
  "description": "CDP 기반 캡처: 화면, 전체, 요소 (개발자용, 압축 해제 로드)",
  "minimum_chrome_version": "141",
  "permissions": [
    "debugger",
    "downloads",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "extension/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "CDP Screenshot 패널 열기/닫기"
  },
  "side_panel": {
    "default_path": "extension/panel.html"
  },
  "commands": {
    "viewport": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "화면 캡처"
    },
    "full": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "전체 캡처"
    },
    "element": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "요소 캡처"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "캡처 패널 열기/닫기"
    }
  }
}
