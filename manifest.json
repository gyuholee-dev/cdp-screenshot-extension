{
  "manifest_version": 3,
  "name": "CDP Screenshot",
  "version": "0.1.0",
  "description": "CDP 기반 스크린샷: 화면, 전체, 엘리먼트 (개발자용, 압축 해제 로드)",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "contextMenus", "downloads", "activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "extension/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "CDP Screenshot 설정"
  },
  "options_ui": {
    "page": "extension/options.html",
    "open_in_tab": true
  },
  "commands": {
    "viewport": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "스크린샷"
    },
    "full": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "전체 스크린샷"
    },
    "element": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "엘리먼트 스크린샷"
    }
  }
}
